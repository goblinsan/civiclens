# Copy to /opt/civreveal/api.env on the home server (mode 600). Never commit real values.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Allowed browser origins for the API (comma-separated).
CORS_ORIGINS=https://civreveal.org,https://www.civreveal.org
# Optional: Cloudflare Turnstile secret for the public-sentiment widget.
# TURNSTILE_SECRET_KEY=
LOG_LEVEL=info
